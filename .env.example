# Copy to .env for `docker compose`, and replace every value with a long
# random string, e.g. the output of: openssl rand -hex 24
# (scripts/demo.sh writes a .env like this for you when there is none.)

# Password of the bundled PostgreSQL; only the gateway can reach it.
POSTGRES_PASSWORD=change-me
# Bearer token for the admin API and for `mcp-warden demo` (16+ characters).
WARDEN_ADMIN_TOKEN=change-me-to-at-least-16-chars
# Key for HMAC digests of tool arguments in the audit log (16+ bytes).
WARDEN_AUDIT_HASH_KEY=change-me-to-at-least-16-chars
